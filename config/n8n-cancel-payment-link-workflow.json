      "parameters": {
        "jsCode": "const b = $('Webhook API').first().json.body || {};\nconst invoiceNumber = String(b.invoiceNumber || b.order?.invoice_number || b.invoice_number || '').trim();\nconst originalRequestId = String(\n  b.originalRequestId ||\n  b.payment?.original_request_id ||\n  b.requestId ||\n  b.original_request_id ||\n  ('REQ-' + invoiceNumber)\n).trim();\nconst note = String(b.reason || b.note || 'Cancelled order via GDG Jakarta Dashboard').trim().substring(0, 128);\n\nfor (let i of $input.all()) {\n  i.json.requestBody = {\n    order: {\n      invoice_number: invoiceNumber\n    },\n    payment: {\n      original_request_id: originalRequestId\n    },\n    note: note\n  };\n}\nreturn $input.all();"
      },
