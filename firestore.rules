rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // This security rules file assumes the following data structures:
    //
    // Collection: members
    // Document ID: memberId (UID or Bevy User ID)
    // Fields:
    //   - id: string|null (optional, immutable for members, 1-128 chars) - Member ID (UID or Bevy User ID)
    //   - uid: string|null (optional, immutable for members, <= 128 chars) - Firebase Auth UID
    //   - bevy_user_id: string|int|float|null (optional) - Associated Bevy User ID
    //   - bevy_member_id: string|int|float|null (optional) - Associated Bevy Member ID
    //   - name: string (required, 1-150 chars) - Full display name
    //   - first_name: string|null (optional, <= 100 chars) - First name
    //   - last_name: string|null (optional, <= 100 chars) - Last name
    //   - email: string (required, valid email, <= 150 chars) - Member email address
    //   - company: string|null (optional, <= 200 chars) - Company or organization name
    //   - company_or_institution: string|null (optional, <= 200 chars) - Alternate company or institution
    //   - title: string|null (optional, <= 200 chars) - Professional title or job role
    //   - role: string|null (optional, immutable for members) - Chapter role ('organizer'|'Organizer'|'Core Team'|'core_team'|'core-team'|'Check-in Staff'|'check_in_staff'|'checkin_staff'|'check-in staff'|'Team Member'|'team_member'|'team-member'|'googler'|'Googler'|'Member'|'member')
    //   - chapter_role: string|null (optional, <= 100 chars) - Bevy chapter role title
    //   - team: string|null (optional, immutable for members) - Team assignment ('Core Team'|'core_team'|'core-team'|'Community'|'community')
    //   - status: string|null (optional) - Membership status ('Active'|'Inactive'|'active'|'inactive')
    //   - joined_date: string|null (optional, <= 50 chars) - Date joined
    //   - raw_created_date: string|null (optional, <= 50 chars) - Raw timestamp from Bevy
    //   - created_at: string|null (optional, <= 50 chars) - Creation timestamp
    //   - events_registered_count: int|float|null (optional, >= 0) - Registered events count
    //   - avatar_url: string|null (optional, <= 3000 chars) - Profile picture URL
    //   - profile_url: string|null (optional, <= 2000 chars) - Public profile URL
    //   - is_email_verified: bool|null (optional) - Email verification status
    //   - phone: string|null (optional, <= 50 chars) - Phone number
    //   - events_attended_count: int|float|null (optional, >= 0) - Check-in / attended events count
    //   - last_active: string|null (optional, <= 50 chars) - Last activity timestamp
    //   - notes: string|null (optional, <= 5000 chars) - Organizer notes
    //   - synced_from_bevy_at: string|null (optional, <= 50 chars) - Bevy sync timestamp
    //   - updated_at: string (required, <= 50 chars) - Last update timestamp
    //   - referral_code: string|null (optional, <= 64 chars) - Member referral sharing code
    //   - referral_points: int|float|null (optional, >= 0) - Accumulated referral reward points
    //   - referrals_count: int|float|null (optional, >= 0) - Successful referrals count
    //   - has_used_referral: bool|null (optional) - Whether member has redeemed a referral code
    //   - referred_by_code: string|null (optional, <= 64 chars) - Referral code redeemed by member
    //   - bio: string|null (optional, <= 5000 chars)
    //   - city: string|null (optional, <= 200 chars)
    //   - country: string|null (optional, <= 200 chars)
    //   - role_id, roleId: string|int|float|null (optional)
    //   - website, linkedin, github, twitter: string|null (optional, <= 2000 chars)
    //   - photo_url: string|null (optional, <= 3000 chars)
    //   - badges: list|null (optional, <= 100 items)
    //   - social_links: map|list|null (optional, <= 20 items/keys)
    // Permissions:
    //   - get: Profile self-reads (by UID, Bevy ID doc match with uid/id, non-existent doc, or referral_code) evaluated before team access (Organizers & Staff).
    //   - list: Team access or authenticated users with limit <= 5 (for referral lookup).
    //   - create: Profile owner initializing account with 0 referral points/count, or team access creating for another member.
    //   - update: Team access (inspecting resource.data directly without circular lookups on self, allows organizers to update members), profile owner (validating identity via isMemberDocOwner, preserving referral points/count, preserving role/team with case/format insensitivity), or authenticated users awarding referral points (restricted to referral_points, referrals_count, updated_at).
    //   - delete: Organizers only (using non-circular role inspection on self).
    //
    // Collection: event_registrations
    // Document ID: registrationId (e.g. eventId_memberId)
    // Fields:
    //   - id: string (required, immutable, <= 200 chars) - Registration ID
    //   - event_id: string (required, immutable, <= 128 chars) - Event ID
    //   - event_title: string (required, <= 1000 chars) - Event title
    //   - event_picture_url: string|null (optional, <= 50000 chars) - Event thumbnail image URL or base64 data URI
    //   - event_banner_url: string|null (optional, <= 50000 chars) - Event banner image URL or base64 data URI
    //   - member_id: string (required, immutable, <= 128 chars) - Member UID
    //   - member_name: string (required, <= 150 chars) - Member display name
    //   - member_email: string (required, <= 150 chars) - Member email
    //   - member_phone: string|null (optional, <= 50 chars) - Member phone number
    //   - member_avatar: string|null (optional, <= 3000 chars) - Avatar URL
    //   - member_role: string|null (optional, <= 100 chars) - Member role
    //   - status: string (required) - Registration status ('pending'|'approved'|'registered'|'rejected'|'waitlisted'|'attended'|'waiting_for_payment'|'paid_and_registered'|'expired'|'failed'|'canceled'|'cancelled')
    //   - answers: map|null (optional, <= 500 keys) - Custom question answers
    //   - notes: string|null (optional, <= 2000 chars) - Registration notes
    //   - ticket_tier: string|null (optional, <= 100 chars) - Ticket tier name
    //   - ticket_id: string|int|float|null (optional, <= 128 chars if string) - Selected ticket tier ID
    //   - ticket_name: string|null (optional, <= 200 chars) - Selected ticket tier name
    //   - ticket_type: string|null (optional, <= 50 chars) - Ticket type ('free'|'paid'|'commitment_fee')
    //   - ticket_price: int|float|null (optional, >= 0) - Ticket price
    //   - bundle_id: string|int|float|null (optional, <= 128 chars if string)
    //   - bundle_name: string|null (optional, <= 200 chars)
    //   - bundle_price: int|float|null (optional, >= 0)
    //   - selected_merchandise: list|null (optional, <= 50 items) - Selected merchandise orders
    //   - session_id: string|int|float|null (optional, <= 128 chars if string) - Selected session identifier
    //   - session_title: string|null (optional, <= 200 chars) - Selected session title
    //   - registered_at: string (required, <= 50 chars) - Registration timestamp
    //   - registered_at_millis: int|float (required on create, epoch timestamp in milliseconds)
    //   - reviewed_at: string|null (optional, immutable for members, <= 50 chars) - Review timestamp
    //   - reviewed_by_id: string|null (optional, immutable for members, <= 128 chars) - Reviewer UID
    //   - reviewed_by_name: string|null (optional, immutable for members, <= 150 chars) - Reviewer name
    //   - reviewed_by_email: string|null (optional, immutable for members, <= 150 chars) - Reviewer email
    //   - status_logs: list|null (optional, <= 100 items) - Status transition history
    //   - checked_in_at: string|null (optional, immutable for members, <= 50 chars) - Check-in timestamp
    //   - is_checked_in: bool|null (optional, immutable for members) - Check-in flag
    //   - bevy_attendee_id: int|float|string|null (optional, immutable for members, <= 64 chars) - Associated Bevy attendee ID
    //   - checkin_date: string|null (optional, <= 50 chars) - Check-in date string
    //   - attendee_code: string|null (optional, immutable for members, <= 100 chars) - Attendee ticket QR tag / code
    //   - payment_status: string|null (optional, <= 50 chars) - DOKU Checkout payment status ('unpaid'|'pending'|'paid'|'expired'|'failed'|'canceled'|'cancelled'|'refunded'|'PENDING'|'PAID'|'FAILED'|'EXPIRED'|'REFUNDED'|'SUCCESS')
    //   - payment_url: string|null (optional, <= 2000 chars) - DOKU payment redirect URL
    //   - payment_invoice_number: string|null (optional, <= 128 chars) - DOKU invoice number
    //   - payment_amount: int|float|string|null (optional, >= 0 if number, <= 30 chars if string) - Total payment amount in IDR
    //   - payment_expired_datetime: string|int|float|null (optional, <= 100 chars if string) - DOKU invoice expiry timestamp
    //   - voucher_id: string|null (optional, <= 128 chars) - Applied discount voucher ID
    //   - voucher_code: string|null (optional, <= 64 chars) - Applied discount voucher code
    //   - voucher_discount_amount: int|float|null (optional, >= 0) - Calculated voucher discount amount
    //   - voucher_discount_type: string|null (optional) - Voucher calculation type ('percentage'|'fixed')
    //   - voucher_discount_value: int|float|null (optional, >= 0) - Voucher discount face value
    //   - voucher_applies_to: string|null (optional) - Voucher application scope ('ticket'|'bundle'|'merchandise'|'all')
    //   - referral_code: string|null (optional, <= 64 chars) - Referral code used during registration
    //   - referrer_member_id: string|null (optional, <= 128 chars) - Member UID of referrer
    //   - referrer_name: string|null (optional, <= 150 chars) - Display name of referrer
    //   - referral_discount_percent: int|float|string|null (optional, 0..100 if number, <= 10 chars if string) - Referral discount percentage applied
    //   - referral_discount_percentage: int|float|string|null (optional, 0..100 if number, <= 10 chars if string) - Referral discount percentage
    //   - referral_discount_type: string|null (optional) - Referral discount calculation type ('percentage'|'fixed')
    //   - referral_discount_amount: int|float|string|null (optional, >= 0 if number, <= 30 chars if string) - Referral discount amount in IDR
    //   - discount_percentage: int|float|string|null (optional, 0..100 if number, <= 10 chars if string)
    //   - discount_amount: int|float|string|null (optional, >= 0 if number, <= 30 chars if string)
    //   - discount_type: string|null (optional)
    //   - points_awarded: int|float|string|null (optional, >= 0 if number, <= 20 chars if string)
    //   - referrer_code: string|null (optional, <= 64 chars)
    //   - referee_id: string|null (optional, <= 128 chars)
    //   - referee_name: string|null (optional, <= 150 chars)
    //   - referee_email: string|null (optional, <= 150 chars)
    //   - delivery_request: map|null (optional) - Merchandise delivery request for no-show attendees
    //     Fields in delivery_request:
    //       - id: string (required, <= 200 chars) - Delivery request ID
    //       - status: string (required) - Status ('pending_payment'|'pending_review'|'approved'|'rejected'|'delivered')
    //       - recipient_name: string (required, <= 150 chars) - Recipient name
    //       - recipient_phone: string (required, <= 50 chars) - Recipient phone number
    //       - shipping_address: string (required, <= 1000 chars) - Shipping street address
    //       - city: string (required, <= 150 chars) - City / region
    //       - postal_code: string (required, <= 20 chars) - Postal code
    //       - notes: string|null (optional, <= 1000 chars) - Delivery notes
    //       - requested_at: string (required, <= 50 chars) - Request timestamp ISO string
    //       - fee_amount: int|float (required, >= 0) - Delivery fee amount in IDR (Rp 50.000)
    //       - payment_status: string (required) - Payment status ('unpaid'|'pending'|'paid'|'failed')
    //       - payment_url: string|null (optional, <= 2000 chars) - Payment link
    //       - payment_invoice_number: string|null (optional, <= 128 chars) - Payment invoice reference
    //       - payment_environment: string|null (optional) - Payment environment ('production'|'sandbox')
    //       - paid_at: string|null (optional, <= 50 chars) - Payment confirmation timestamp
    //       - courier_type: string|null (optional, <= 50 chars) - Courier service code
    //       - tracking_number: string|null (optional, <= 128 chars) - Package tracking number / resi
    //       - tracking_url: string|null (optional, <= 2000 chars) - Courier tracking URL
    //       - delivery_proof_url: string|null (optional, <= 2000 chars) - Proof of shipment or delivery URL
    //       - dispatched_at: string|null (optional, <= 50 chars) - Package dispatch timestamp
    //       - delivered_at: string|null (optional, <= 50 chars) - Package delivered timestamp
    //       - rejection_reason: string|null (optional, <= 1000 chars) - Organizer rejection explanation
    //       - reviewed_by_id: string|null (optional, <= 128 chars) - Reviewer UID
    //       - reviewed_by_name: string|null (optional, <= 150 chars) - Reviewer display name
    //       - reviewed_at: string|null (optional, <= 50 chars) - Review timestamp
    //       - updated_at: string (required, <= 50 chars) - Last update timestamp
    //   - refund_request: map|null (optional) - Refund request for paid waitlisted attendees
    //     Fields in refund_request:
    //       - id: string (required, <= 200 chars) - Refund request ID
    //       - status: string (required) - Status ('waiting_for_approval'|'refund_completed'|'rejected')
    //       - bank_name: string (required, <= 100 chars) - Bank name
    //       - bank_account_name: string (required, <= 150 chars) - Account holder name
    //       - bank_account_number: string (required, <= 50 chars) - Bank account number
    //       - cancellation_reason: string (required, <= 1000 chars) - Cancellation explanation
    //       - refund_amount: int|float (required, >= 0) - Refund amount in IDR
    //       - proof_media_url: string|null (optional, <= 2000 chars) - Proof media URL
    //       - requested_at: string (required, <= 50 chars) - Request timestamp ISO string
    //       - completion_proof_url: string|null (optional, organizer-only, <= 2000 chars) - Transfer proof receipt URL
    //       - completion_notes: string|null (optional, organizer-only, <= 1000 chars)
    //       - completed_at: string|null (optional, organizer-only, <= 50 chars)
    //       - completed_by_id: string|null (optional, organizer-only, <= 128 chars)
    //       - completed_by_name: string|null (optional, organizer-only, <= 150 chars)
    //       - completed_by_email: string|null (optional, organizer-only, <= 150 chars)
    //       - rejection_reason: string|null (optional, organizer-only, <= 1000 chars)
    //       - rejected_at: string|null (optional, organizer-only, <= 50 chars)
    //       - rejected_by_id: string|null (optional, organizer-only, <= 128 chars)
    //       - rejected_by_name: string|null (optional, organizer-only, <= 150 chars)
    //       - rejected_by_email: string|null (optional, organizer-only, <= 150 chars)
    //       - updated_at: string (required, <= 50 chars) - Last update timestamp
    //   - updated_at: string|null (optional, <= 50 chars) - Last update timestamp
    //
    // Collection: events
    // Document ID: eventId
    // Fields:
    //   - id: string (required, immutable, <= 128 chars) - Event ID
    //   - title: string (required, <= 300 chars) - Event title
    //   - description: string|null (optional, <= 50000 chars) - Full description / HTML
    //   - description_short: string|null (optional, <= 1000 chars) - Short summary
    //   - status: string (required) - Status ('Draft'|'Published'|'Completed'|'Canceled'|'Live'|'Past')
    //   - start_date: string (required, <= 50 chars) - Start date ISO string
    //   - end_date: string (required, <= 50 chars) - End date ISO string
    //   - picture_url: string|null (optional, <= 2000 chars) - Thumbnail image URL
    //   - banner_url: string|null (optional, <= 2000 chars) - Header banner image URL
    //   - picture: map|null (optional, <= 10 keys) - Bevy image object with url and thumbnail_url
    //   - banner: map|null (optional, <= 10 keys) - Bevy banner object with url and thumbnail_url
    //   - cropped_picture_url: string|null (optional, <= 2000 chars) - Cropped square thumbnail URL
    //   - cropped_banner_url: string|null (optional, <= 2000 chars) - Cropped wide banner URL
    //   - event_type_title: string|null (optional, <= 100 chars) - Category / event type
    //   - audience_type: string|null (optional, <= 50 chars) - Audience type
    //   - is_virtual: bool|null (optional) - Virtual event flag
    //   - venue: map|null (optional, <= 20 keys) - Venue location details
    //   - url: string|null (optional, <= 2000 chars) - External Bevy URL
    //   - static_url: string|null (optional, <= 2000 chars) - Static landing URL
    //   - tags: list|null (optional, <= 50 items) - Search tags
    //   - is_hidden: bool|null (optional) - Hidden visibility flag
    //   - is_test: bool|null (optional) - Test event flag
    //   - requires_approval: bool|null (optional) - Organizer RSVP review requirement
    //   - curation_mode: bool|null (optional) - Curated applicant review mode flag
    //   - allow_waitlist: bool|null (optional) - Allow waitlist registration flag
    //   - max_attendees: int|float|null (optional, >= 0) - Attendee capacity limit
    //   - total_registrations: int|float (required, >= 0) - Registered attendee count
    //   - total_approved: int|float|null (optional, >= 0) - Approved attendee count
    //   - total_checked_in: int|float|null (optional, >= 0) - Checked-in attendee count
    //   - total_waitlisted: int|float|null (optional, >= 0) - Waitlisted attendee count
    //   - custom_questions: list|null (optional, <= 50 items) - Custom RSVP questions
    //   - agenda: map|list|null (optional, <= 20 items/keys) - Bevy event agenda structure
    //   - speakers: list|null (optional, <= 50 items) - Event featured speakers
    //   - sessions: list|null (optional, <= 30 items) - Event agenda / breakout sessions
    //   - webhook_url: string|null (optional, <= 2000 chars) - Webhook integration URL
    //   - payment_webhook_url: string|null (optional, <= 2000 chars) - Payment webhook URL
    //   - payment_environment: string|null (optional) - Payment environment ('production'|'sandbox')
    //   - merchandise_delivery_payment_environment: string|null (optional) - Delivery fee payment environment ('production'|'sandbox')
    //   - merchandise_delivery_fee: int|float|null (optional, >= 0) - Fixed shipping delivery fee override in IDR
    //   - registration_status: string|null (optional) - Registration window status ('Draft'|'Published'|'Closed')
    //   - registration_start_date: string|null (optional, <= 50 chars) - Registration start date ISO string
    //   - registration_end_date: string|null (optional, <= 50 chars) - Registration end date ISO string
    //   - tickets: list|null (optional, <= 50 items) - Ticket tiers configuration
    //   - max_tickets_per_person: int|float|null (optional, >= 0) - Limit tickets per person
    //   - merchandise: list|null (optional, <= 50 items) - Merchandise items configuration
    //   - max_merchandise_per_person: int|float|null (optional, >= 0) - Limit merchandise per person
    //   - bundles: list|null (optional, <= 50 items) - Bundling packages combining tickets & merchandise
    //   - vouchers: list|null (optional, <= 50 items) - Event discount vouchers configuration
    //   - referral_discount_percentage: int|float|null (optional, 0..100) - Referral discount percentage for this event
    //   - referral_discount_type: string|null (optional) - Referral discount calculation type ('percentage'|'fixed')
    //   - referral_discount_amount: int|float|null (optional, >= 0) - Referral discount fixed amount in IDR
    //   - referral_enabled: bool|null (optional) - Referral discount toggle for this event
    //   - refund_enabled: bool|null (optional) - Refund request toggle for this event
    //   - refund_cutoff_days_before: int|float|null (optional, >= 0) - Days before event when refund cutoff applies
    //   - refund_cutoff_date: string|null (optional, <= 50 chars) - Explicit refund cutoff date ISO string
    //   - refund_policy_notes: string|null (optional, <= 2000 chars) - Custom refund policy guidelines notes
    //   - highlight_video_url: string|null (optional, <= 2000 chars) - Highlight video URL
    //   - highlight_video_title: string|null (optional, <= 300 chars) - Highlight video title
    //   - photo_album_url: string|null (optional, <= 2000 chars) - Photo album URL
    //   - photo_album_title: string|null (optional, <= 300 chars) - Photo album title
    //   - recap_description: string|null (optional, <= 10000 chars) - Post-event recap description
    //   - email_templates: map|null (optional, <= 20 keys) - Email template configurations
    //   - synced_from_bevy_at: string|null (optional, <= 50 chars) - Bevy sync timestamp
    //   - created_at: string|null (optional, <= 50 chars) - Creation timestamp
    //   - updated_at: string (required, <= 50 chars) - Last update timestamp
    //
    // Collection: event_vouchers
    // Document ID: voucherDocId (e.g. `${eventId}_${normalizedCode}` or voucherId)
    // Fields:
    //   - id: string (required, 1-128 chars) - Unique voucher identifier
    //   - event_id: string (required, 1-128 chars) - Associated event identifier
    //   - code: string (required, 1-64 chars) - Voucher promo / sponsor code
    //   - description: string|null (optional, <= 500 chars) - Voucher description or perks
    //   - discount_type: string (required) - Discount calculation type ('percentage'|'fixed')
    //   - discount_value: int|float (required, >= 0) - Discount face value in IDR or percentage
    //   - applies_to: string (required) - Discount application scope ('all'|'ticket'|'merchandise')
    //   - usage_limit: int|float|null (optional, >= 0) - Total redemptions limit (null = unlimited)
    //   - times_used: int|float|null (optional, >= 0) - Times voucher has been redeemed
    //   - min_spend: int|float|null (optional, >= 0) - Minimum eligible cart amount in IDR
    //   - max_discount: int|float|null (optional, >= 0) - Maximum discount cap in IDR
    //   - start_date: string|null (optional, <= 50 chars) - Validity start timestamp ISO string
    //   - end_date: string|null (optional, <= 50 chars) - Validity end timestamp ISO string
    //   - status: string (required) - Voucher lifecycle status ('active'|'inactive'|'expired')
    //   - created_at: string (required, <= 50 chars) - Creation timestamp ISO string
    //   - updated_at: string (required, <= 50 chars) - Last update timestamp ISO string
    //   - source_bundle_id: string|null (optional, <= 128 chars) - Bundle package ID that generated this voucher
    //   - source_registration_id: string|null (optional, <= 200 chars) - Buyer registration ID for bundle vouchers
    //   - redeemed_by_member_id: string|null (optional, <= 128 chars) - Member UID who redeemed voucher
    //   - redeemed_by_name: string|null (optional, <= 150 chars) - Member name who redeemed voucher
    //   - redeemed_by_email: string|null (optional, <= 150 chars) - Member email who redeemed voucher
    //   - redeemed_at: string|null (optional, <= 50 chars) - Redemption timestamp ISO string
    //   - purchaser_member_id: string|null (optional, <= 128 chars) - Buyer member UID for bundle vouchers
    //   - purchaser_name: string|null (optional, <= 150 chars) - Buyer name for bundle vouchers
    //   - purchaser_email: string|null (optional, <= 150 chars) - Buyer email for bundle vouchers
    // Permissions:
    //   - get: Public / anyone (`if true;`) to allow single voucher validation by exact doc ID / code during checkout without exposing other codes.
    //   - list: Restricted strictly to team members (`hasTeamAccess()`) to prevent scraping secret promo & sponsor vouchers.
    //   - create, delete: Team members only (`hasTeamAccess()`).
    //   - update: Team members (`hasTeamAccess()`) or authenticated users updating redemption fields (`times_used`, `redeemed_by_*`, `redeemed_at`, `updated_at`).
    //
    // Collection: sync_metadata
    // Document ID: bevy
    // Fields:
    //   - id: string (required, 'bevy') - Sync document ID
    //   - last_synced_events_at: string|null (optional, <= 50 chars) - Events sync timestamp
    //   - last_synced_members_at: string|null (optional, <= 50 chars) - Members sync timestamp
    //   - total_events_synced: int|float|null (optional, >= 0) - Total events synced
    //   - total_members_synced: int|float|null (optional, >= 0) - Total members synced
    //   - status: string (required) - Sync status ('idle'|'syncing'|'success'|'error')
    //   - error_message: string|null (optional, <= 2000 chars) - Error message if sync failed
    //   - synced_by: string|null (optional, <= 128 chars) - UID of organizer who ran sync
    //
    // Collection: content_settings
    // Document ID: faq, partnership, featured_event
    // Fields (faq, partnership):
    //   - header: map|null (optional, <= 20 keys)
    //   - notice: map|null (optional, <= 20 keys)
    //   - categories: list|null (optional, <= 50 items)
    //   - items: list|null (optional, <= 100 items)
    //   - contact: map|null (optional, <= 20 keys)
    //   - faqs: list|null (optional, <= 100 items)
    //   - hero: map|null (optional, <= 20 keys)
    //   - whyUs: list|null (optional, <= 50 items)
    //   - devfest: map|null (optional, <= 20 keys)
    //   - formats: list|null (optional, <= 50 items)
    //   - benefits: list|null (optional, <= 50 items)
    //   - tiers: list|null (optional, <= 50 items)
    //   - partnerTiers: list|null (optional, <= 50 items)
    //   - sponsors: list|null (optional, <= 50 items)
    //   - updatedAt: string|null (optional, <= 50 chars)
    //   - updatedBy: string|null (optional, <= 150 chars)
    // Fields (featured_event):
    //   - enabled: bool|null (optional)
    //   - eventId: string|null (optional, <= 100 chars)
    //   - badge: string|null (optional, <= 100 chars)
    //   - title: string|null (optional, <= 200 chars)
    //   - description: string|null (optional, <= 2000 chars)
    //   - dateString: string|null (optional, <= 100 chars)
    //   - location: string|null (optional, <= 200 chars)
    //   - ctaText: string|null (optional, <= 100 chars)
    //   - ctaUrl: string|null (optional, <= 500 chars)
    //   - secondaryCtaText: string|null (optional, <= 100 chars)
    //   - secondaryCtaUrl: string|null (optional, <= 500 chars)
    //   - videoSourceType: string|null (optional, 'url'|'upload')
    //   - videoUrl: string|null (optional, <= 1000 chars)
    //   - videoPosterUrl: string|null (optional, <= 1000 chars)
    //   - videoStorageKey: string|null (optional, <= 500 chars)
    //   - autoplay: bool|null (optional)
    //   - muted: bool|null (optional)
    //   - loop: bool|null (optional)
    //   - showControls: bool|null (optional)
    //   - updatedAt: string|null (optional, <= 50 chars)
    //   - updatedBy: string|null (optional, <= 150 chars)
    //
    // Collection: audit_logs
    // Document ID: auditId (auto-generated ID)
    // Fields:
    //   - id: string|null (optional, <= 128 chars) - Audit log entry ID
    //   - action: string (required, <= 100 chars) - Audit action type ('registration_status_change'|'event_update'|'member_update')
    //   - entity_type: string (required, <= 50 chars) - Target entity ('registration'|'event'|'member')
    //   - entity_id: string (required, <= 200 chars) - Target entity identifier
    //   - event_id: string|null (optional, <= 128 chars) - Associated event ID
    //   - event_title: string|null (optional, <= 300 chars) - Associated event title
    //   - member_id: string|null (optional, <= 128 chars) - Associated member ID
    //   - member_name: string|null (optional, <= 150 chars) - Associated member display name
    //   - member_email: string|null (optional, valid email, <= 150 chars) - Associated member email
    //   - actor_id: string (required, <= 128 chars) - Actor UID
    //   - actor_name: string (required, <= 150 chars) - Actor display name
    //   - actor_email: string|null (optional, valid email, <= 150 chars) - Actor email
    //   - previous_value: string|int|float|bool|null (optional, <= 2000 chars if string) - Value before transition
    //   - new_value: string|int|float|bool|null (optional, <= 2000 chars if string) - Value after transition
    //   - notes: string|null (optional, <= 2000 chars) - Change notes / comments
    //   - timestamp: string (required, <= 50 chars) - Action timestamp ISO string
    //
    // Collection: referral_redemptions
    // Document ID: redemptionId (e.g. `${referee_id}_${registration_id}`)
    // Fields:
    //   - id: string (required, <= 200 chars) - Redemption record ID
    //   - referrer_id: string (required, <= 128 chars) - Referrer member UID
    //   - referrer_name: string|null (optional, <= 150 chars) - Referrer display name
    //   - referrer_email: string|null (optional, <= 150 chars) - Referrer email
    //   - referrer_code: string|null (optional, <= 64 chars) - Referral code used
    //   - referral_code: string|null (optional, <= 64 chars) - Referral code
    //   - referee_id: string (required, <= 128 chars) - Referee member UID
    //   - referee_member_id: string|null (optional, <= 128 chars) - Referee member UID
    //   - referee_name: string|null (optional, <= 150 chars) - Referee display name
    //   - referee_email: string|null (optional, <= 150 chars) - Referee email
    //   - event_id: string (required, <= 128 chars) - Event ID
    //   - event_title: string|null (optional, <= 1000 chars) - Event title
    //   - ticket_id: string|int|float|null (optional, <= 128 chars if string) - Selected ticket tier ID
    //   - ticket_name: string|null (optional, <= 200 chars) - Selected ticket tier name
    //   - ticket_type: string|null (optional, <= 50 chars) - Ticket type ('free'|'paid'|'commitment_fee')
    //   - ticket_price: int|float|null (optional, >= 0) - Ticket price
    //   - discount_percentage: int|float|string|null (optional, 0..100 if number, <= 10 chars if string) - Applied discount percentage
    //   - discount_percent: int|float|string|null (optional, 0..100 if number, <= 10 chars if string)
    //   - referral_discount_percent: int|float|string|null (optional, 0..100 if number, <= 10 chars if string)
    //   - discount_type: string|null (optional) - Applied discount calculation type ('percentage'|'fixed')
    //   - discount_amount: int|float|string|null (optional, >= 0 if number, <= 30 chars if string) - Applied discount amount
    //   - referral_discount_amount: int|float|string|null (optional, >= 0 if number, <= 30 chars if string)
    //   - points_awarded: int|float (required, >= 0) - Referral points awarded to referrer
    //   - registration_id: string|null (optional, <= 200 chars) - Associated registration ID
    //   - created_at: string (required, <= 50 chars) - Creation timestamp ISO string
    //   - updated_at: string|null (optional, <= 50 chars) - Last update timestamp
    // Permissions:
    //   - get, list: Team access (Organizers & Staff), or authenticated participants (referrer or referee).
    //   - create, update: Team access (Organizers & Staff), or authenticated participants (as referee).
    //   - delete: Team access (Organizers & Staff).
    //
    // Collection: system_settings
    // Document ID: settingId (e.g. 'referral', 'maintenance')
    // Fields ('referral'):
    //   - id: string|null (optional, <= 128 chars) - Setting document identifier
    //   - default_discount_type: string|null (optional) - Master default discount type ('percentage'|'fixed')
    //   - default_discount_percentage: int|float|null (optional, 0..100) - Default referral discount percentage
    //   - default_discount_amount: int|float|null (optional, >= 0) - Default referral discount fixed amount in IDR
    //   - points_per_referral: int|float|null (optional, >= 0) - Points awarded per referral
    //   - is_active: bool|null (optional) - Program toggle
    //   - merch_prize_description: string|null (optional, <= 1000 chars) - Prize description
    //   - excluded_member_ids: list|null (optional, <= 5000 items) - Member IDs excluded from referral program
    //   - auto_exclude_organizers: bool|null (optional) - Automatically exclude organizers from leaderboard/rewards
    //   - auto_exclude_roles: list|null (optional, <= 20 items) - Roles automatically excluded from leaderboard/rewards (e.g. ['googler', 'organizer', 'team_member'])
    //   - updated_at: string|null (optional, <= 100 chars) - Last update timestamp
    //   - updated_by_name: string|null (optional, <= 200 chars) - Updater display name
    // Fields ('maintenance'):
    //   - id: string|null (optional, <= 128 chars) - Setting document identifier
    //   - enabled: bool|null (optional) - Maintenance mode toggle
    //   - title: string|null (optional, <= 200 chars) - Maintenance page title
    //   - headline: string|null (optional, <= 300 chars) - Maintenance page headline
    //   - message: string|null (optional, <= 2000 chars) - Maintenance message / details
    //   - estimatedEndTime: string|null (optional, <= 100 chars) - Estimated completion timestamp or date string
    //   - allowOrganizerBypass: bool|null (optional) - Allow organizers to bypass maintenance mode
    //   - contactEmail: string|null (optional, <= 200 chars) - Contact email address
    //   - supportLink: string|null (optional, <= 500 chars) - Support / social URL
    //   - showSocialLinks: bool|null (optional) - Display social links toggle
    //   - updatedAt: string|null (optional, <= 100 chars) - Last update timestamp
    //   - updatedBy: string|null (optional, <= 128 chars) - Updater UID
    //   - updatedByName: string|null (optional, <= 200 chars) - Updater display name
    // Permissions:
    //   - read: Allowed for authenticated users and public visitors.
    //   - create, update, delete: Team access (Organizers & Staff / Core Team).
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }


    // Check if the authenticated user is the owner of the member document
    // Supports both Firebase Auth UID as memberId or Bevy user ID with uid/id field match
    function isMemberDocOwner(memberId, existingResource) {
      return isAuthenticated() && (
        request.auth.uid == memberId ||
        (existingResource != null && (
          (('uid' in existingResource.data) && existingResource.data.uid == request.auth.uid) ||
          (('id' in existingResource.data) && existingResource.data.id == request.auth.uid)
        ))
      );
    }

    // Dynamic Organizer Data Verification:
    // Evaluates member document fields directly without document get().
    function isOrganizerData(data) {
      return data != null && (
        (
          'role' in data && data.role is string &&
          data.role in [
            'organizer', 'Organizer', 'Core Team', 'core_team', 'core-team', 'googler', 'Googler'
          ]
        ) ||
        (
          'team' in data && data.team is string &&
          (data.team == 'Core Team' || data.team == 'core_team' || data.team == 'core-team')
        ) ||
        (
          'chapter_role' in data && data.chapter_role is string &&
          (
            data.chapter_role in [
              'organizer', 'Organizer', 'Core Team', 'core team', 'core_team', 'googler', 'Googler'
            ] ||
            data.chapter_role.matches('.*[oO]rganizer.*') ||
            data.chapter_role.matches('.*Core Team.*')
          )
        )
      );
    }

    // Dynamic Staff Member Data Verification:
    // Evaluates operational staff roles directly without document get().
    function isStaffData(data) {
      return data != null && (
        (
          'role' in data && data.role is string &&
          data.role in [
            'Core Team', 'core_team', 'core-team',
            'Check-in Staff', 'check_in_staff', 'checkin_staff', 'check-in staff',
            'Team Member', 'team_member', 'team-member'
          ]
        ) ||
        (
          'team' in data && data.team is string &&
          (data.team == 'Core Team' || data.team == 'core_team' || data.team == 'core-team')
        ) ||
        (
          'chapter_role' in data && data.chapter_role is string &&
          (
            data.chapter_role in [
              'Core Team', 'core team', 'Core team',
              'Team Member', 'team member', 'Team member',
              'Check-in Staff', 'check-in staff', 'Check-In Staff',
              'Check-in', 'Staff'
            ] ||
            data.chapter_role.matches('.*Team Member.*') ||
            data.chapter_role.matches('.*Staff.*')
          )
        )
      );
    }

    // Inspects whether a member document's data represents team access (organizer or staff)
    function isTeamData(data) {
      return isOrganizerData(data) || isStaffData(data);
    }

    // Dynamic Organizer Verification:
    // Evaluates custom auth claims or organizer role / chapter role / Core Team membership in the members collection.
    function isOrganizer() {
      return isAuthenticated() && (
        ('role' in request.auth.token && (request.auth.token.role in ['organizer', 'core_team', 'googler'])) ||
        (
          exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
          isOrganizerData(get(/databases/$(database)/documents/members/$(request.auth.uid)).data)
        )
      );
    }

    // Staff Member Verification:
    // Evaluates custom auth claims or member document role / chapter_role / team for operational staff roles.
    function isStaffMember() {
      return isAuthenticated() && (
        ('role' in request.auth.token && (
          request.auth.token.role in [
            'core_team', 'core-team', 'Core Team',
            'check_in_staff', 'checkin_staff', 'Check-in Staff', 'check-in staff',
            'team_member', 'team-member', 'Team Member'
          ]
        )) ||
        (
          exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
          isStaffData(get(/databases/$(database)/documents/members/$(request.auth.uid)).data)
        )
      );
    }

    // Unified operational team access check (Organizers + Staff Members)
    function hasTeamAccess() {
      return isOrganizer() || isStaffMember();
    }

    // Safely check team access for operations in /members/{targetMemberId}.
    // When targetMemberId belongs to caller, inspects existingResource.data directly to avoid
    // circular get() / exists() evaluation on the active document being written.
    function hasMemberTeamAccess(targetMemberId, existingResource) {
      return isAuthenticated() && (
        ('role' in request.auth.token && (request.auth.token.role in [
          'organizer', 'core_team', 'core-team', 'Core Team',
          'googler', 'check_in_staff', 'checkin_staff', 'Check-in Staff',
          'team_member', 'team-member', 'Team Member'
        ])) ||
        (
          isMemberDocOwner(targetMemberId, existingResource) ?
            (existingResource != null && isTeamData(existingResource.data)) :
            hasTeamAccess()
        )
      );
    }

    // Safely check organizer permission for operations in /members/{targetMemberId}.
    function isMemberOrganizer(targetMemberId, existingResource) {
      return isAuthenticated() && (
        ('role' in request.auth.token && (request.auth.token.role in ['organizer', 'core_team', 'googler'])) ||
        (
          isMemberDocOwner(targetMemberId, existingResource) ?
            (existingResource != null && isOrganizerData(existingResource.data)) :
            isOrganizer()
        )
      );
    }

    // Validate email string format
    function isValidEmail(email) {
      return email is string &&
        email.size() > 0 &&
        email.size() <= 150 &&
        email.matches('.*@.*\\..*');
    }

    // Check if document data has all required keys
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Check if document data contains only allowed keys
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validates members document structure, data types, and bounds
    function isValidMember(data) {
      return data != null &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
        data.updated_at is string && data.updated_at.size() <= 50;
    }

    // Validates profile updates performed by the member document owner.
    // Uses MapDiff to safely verify only changed keys without accessing undefined properties.
    function isValidMemberOwnerUpdate(existingData, newData, authUid, memberId) {
      return (
        // Identity check
        (!('id' in newData) || newData.id == memberId || (('id' in existingData) && newData.id == existingData.id)) &&
        (!('uid' in newData) || newData.uid == authUid || (('uid' in existingData) && newData.uid == existingData.uid)) &&

        // Rewards check: if untouched, allowed; if touched, cannot inflate
        (!newData.diff(existingData).affectedKeys().hasAny(['referral_points', 'referrals_count']) ||
          (
            (!newData.diff(existingData).affectedKeys().hasAny(['referral_points']) ||
              (('referral_points' in existingData) && newData.referral_points == existingData.referral_points) ||
              (!('referral_points' in existingData) && (!('referral_points' in newData) || newData.referral_points == 0))) &&
            (!newData.diff(existingData).affectedKeys().hasAny(['referrals_count']) ||
              (('referrals_count' in existingData) && newData.referrals_count == existingData.referrals_count) ||
              (!('referrals_count' in existingData) && (!('referrals_count' in newData) || newData.referrals_count == 0)))
          )
        ) &&

        // Role check: if untouched, allowed; if touched, cannot escalate
        (!newData.diff(existingData).affectedKeys().hasAny(['role']) ||
          isTeamData(existingData) ||
          ('role' in request.auth.token && (request.auth.token.role in ['organizer', 'core_team', 'googler', 'check_in_staff', 'team_member'])) ||
          (newData.role is string && newData.role.lower() in ['member'])
        ) &&

        // Team check: if untouched, allowed; if touched, cannot escalate
        (!newData.diff(existingData).affectedKeys().hasAny(['team']) ||
          isTeamData(existingData) ||
          ('role' in request.auth.token && (request.auth.token.role in ['organizer', 'core_team', 'googler', 'check_in_staff', 'team_member'])) ||
          (newData.team is string && newData.team.lower() in ['community'])
        )
      );
    }

    // Ensures member (registrant) updates to delivery_request are strictly constrained to submission & payment
    function isValidMemberDeliveryUpdate(prevData, newData) {
      return !newData.diff(prevData).affectedKeys().hasAny(['delivery_request']) ||
        (
          ('delivery_request' in newData) &&
          (
            newData.delivery_request == null ||
            (
              newData.delivery_request is map &&
              ('status' in newData.delivery_request) &&
              (newData.delivery_request.status in ['pending_payment', 'pending_review']) &&
              !newData.delivery_request.keys().hasAny([
                'courier_type', 'tracking_number', 'tracking_url', 'delivery_proof_url',
                'dispatched_at', 'delivered_at', 'rejection_reason',
                'reviewed_by_id', 'reviewed_by_name', 'reviewed_at'
              ]) &&
              (
                !('delivery_request' in prevData) ||
                prevData.delivery_request == null ||
                (
                  prevData.delivery_request is map &&
                  (!('status' in prevData.delivery_request) || prevData.delivery_request.status in ['pending_payment', 'pending_review']) &&
                  (!('id' in prevData.delivery_request) || !('id' in newData.delivery_request) || newData.delivery_request.id == prevData.delivery_request.id) &&
                  (!('requested_at' in prevData.delivery_request) || !('requested_at' in newData.delivery_request) || newData.delivery_request.requested_at == prevData.delivery_request.requested_at)
                )
              )
            )
          )
        );
    }

    // Validates event_registrations document structure, data types, and bounds
    function isValidRegistration(data) {
      return hasRequiredFields(data, ['id', 'event_id', 'event_title', 'member_id', 'member_name', 'member_email', 'status', 'registered_at']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 200 &&
        data.event_id is string && data.event_id.size() > 0 && data.event_id.size() <= 128 &&
        data.event_title is string && data.event_title.size() > 0 && data.event_title.size() <= 1000 &&
        data.member_id is string && data.member_id.size() > 0 && data.member_id.size() <= 128 &&
        data.member_name is string && data.member_name.size() > 0 && data.member_name.size() <= 150 &&
        data.member_email is string && data.member_email.size() > 0 && data.member_email.size() <= 150 &&
        data.status is string && data.status.size() > 0 && data.status.size() <= 50 &&
        data.registered_at is string && data.registered_at.size() <= 50 &&
        (!('registered_at_millis' in data) || ((data.registered_at_millis is int || data.registered_at_millis is float) && data.registered_at_millis > 0));
    }

    // Validates events document structure, data types, and bounds
    function isValidEvent(data) {
      return hasRequiredFields(data, ['id', 'title', 'status', 'start_date', 'end_date', 'updated_at']) &&
        hasOnlyAllowedFields(data, [
          'id', 'title', 'description', 'description_short', 'status', 'start_date', 'end_date',
          'picture_url', 'banner_url', 'picture', 'banner', 'cropped_picture_url', 'cropped_banner_url',
          'event_type_title', 'audience_type', 'is_virtual',
          'venue', 'url', 'static_url', 'tags', 'is_hidden', 'is_test', 'requires_approval', 'curation_mode',
          'allow_waitlist',
          'max_attendees', 'total_registrations', 'total_approved', 'total_checked_in', 'total_waitlisted',
          'custom_questions', 'agenda', 'speakers', 'sessions', 'webhook_url',
          'payment_webhook_url', 'payment_environment', 'merchandise_delivery_payment_environment',
          'merchandise_delivery_fee',
          'registration_status', 'registration_start_date', 'registration_end_date',
          'tickets', 'max_tickets_per_person', 'merchandise', 'max_merchandise_per_person',
          'bundles',
          'vouchers',
          'referral_discount_percentage', 'referral_discount_type', 'referral_discount_amount', 'referral_enabled',
          'refund_enabled', 'refund_cutoff_days_before', 'refund_cutoff_date', 'refund_policy_notes',
          'highlight_video_url', 'highlight_video_title', 'photo_album_url', 'photo_album_title', 'recap_description',
          'email_templates',
          'synced_from_bevy_at', 'created_at', 'updated_at'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.status is string && (data.status.lower() in ['draft', 'published', 'completed', 'canceled', 'cancelled', 'live', 'past'] || data.status in ['Draft', 'Published', 'Completed', 'Canceled', 'Live', 'Past']) &&
        data.start_date is string && data.start_date.size() <= 50 &&
        data.end_date is string && data.end_date.size() <= 50 &&
        data.updated_at is string && data.updated_at.size() <= 50 &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 50000)) &&
        (!('description_short' in data) || data.description_short == null || (data.description_short is string && data.description_short.size() <= 1000)) &&
        (!('picture_url' in data) || data.picture_url == null || (data.picture_url is string && data.picture_url.size() <= 2000)) &&
        (!('banner_url' in data) || data.banner_url == null || (data.banner_url is string && data.banner_url.size() <= 2000)) &&
        (!('picture' in data) || data.picture == null || (data.picture is map && data.picture.size() <= 10)) &&
        (!('banner' in data) || data.banner == null || (data.banner is map && data.banner.size() <= 10)) &&
        (!('cropped_picture_url' in data) || data.cropped_picture_url == null || (data.cropped_picture_url is string && data.cropped_picture_url.size() <= 2000)) &&
        (!('cropped_banner_url' in data) || data.cropped_banner_url == null || (data.cropped_banner_url is string && data.cropped_banner_url.size() <= 2000)) &&
        (!('event_type_title' in data) || data.event_type_title == null || (data.event_type_title is string && data.event_type_title.size() <= 100)) &&
        (!('audience_type' in data) || data.audience_type == null || (data.audience_type is string && data.audience_type.size() <= 50)) &&
        (!('is_virtual' in data) || data.is_virtual == null || data.is_virtual is bool) &&
        (!('is_hidden' in data) || data.is_hidden == null || data.is_hidden is bool) &&
        (!('is_test' in data) || data.is_test == null || data.is_test is bool) &&
        (!('requires_approval' in data) || data.requires_approval == null || data.requires_approval is bool) &&
        (!('curation_mode' in data) || data.curation_mode == null || data.curation_mode is bool) &&
        (!('allow_waitlist' in data) || data.allow_waitlist == null || data.allow_waitlist is bool) &&
        (!('venue' in data) || data.venue == null || (data.venue is map && data.venue.size() <= 20)) &&
        (!('url' in data) || data.url == null || (data.url is string && data.url.size() <= 2000)) &&
        (!('static_url' in data) || data.static_url == null || (data.static_url is string && data.static_url.size() <= 2000)) &&
        (!('tags' in data) || data.tags == null || (data.tags is list && data.tags.size() <= 50)) &&
        (!('custom_questions' in data) || data.custom_questions == null || (data.custom_questions is list && data.custom_questions.size() <= 50)) &&
        (!('agenda' in data) || data.agenda == null || (data.agenda is map && data.agenda.size() <= 20) || (data.agenda is list && data.agenda.size() <= 20)) &&
        (!('speakers' in data) || data.speakers == null || (data.speakers is list && data.speakers.size() <= 50)) &&
        (!('sessions' in data) || data.sessions == null || (data.sessions is list && data.sessions.size() <= 30)) &&
        (!('webhook_url' in data) || data.webhook_url == null || (data.webhook_url is string && data.webhook_url.size() <= 2000)) &&
        (!('payment_webhook_url' in data) || data.payment_webhook_url == null || (data.payment_webhook_url is string && data.payment_webhook_url.size() <= 2000)) &&
        (!('payment_environment' in data) || data.payment_environment == null || (data.payment_environment is string && (data.payment_environment in ['production', 'sandbox']))) &&
        (!('merchandise_delivery_payment_environment' in data) || data.merchandise_delivery_payment_environment == null || (data.merchandise_delivery_payment_environment is string && (data.merchandise_delivery_payment_environment in ['production', 'sandbox']))) &&
        (!('merchandise_delivery_fee' in data) || data.merchandise_delivery_fee == null || ((data.merchandise_delivery_fee is int || data.merchandise_delivery_fee is float) && data.merchandise_delivery_fee >= 0)) &&
        (!('max_attendees' in data) || data.max_attendees == null || ((data.max_attendees is int || data.max_attendees is float) && data.max_attendees >= 0)) &&
        (!('total_registrations' in data) || data.total_registrations == null || ((data.total_registrations is int || data.total_registrations is float) && data.total_registrations >= 0)) &&
        (!('total_approved' in data) || data.total_approved == null || ((data.total_approved is int || data.total_approved is float) && data.total_approved >= 0)) &&
        (!('total_checked_in' in data) || data.total_checked_in == null || ((data.total_checked_in is int || data.total_checked_in is float) && data.total_checked_in >= 0)) &&
        (!('total_waitlisted' in data) || data.total_waitlisted == null || ((data.total_waitlisted is int || data.total_waitlisted is float) && data.total_waitlisted >= 0)) &&
        (!('registration_status' in data) || data.registration_status == null || (data.registration_status is string && (data.registration_status in ['Draft', 'Published', 'Closed']))) &&
        (!('registration_start_date' in data) || data.registration_start_date == null || (data.registration_start_date is string && data.registration_start_date.size() <= 50)) &&
