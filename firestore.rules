        (!('headline' in data) || data.headline == null || (data.headline is string && data.headline.size() <= 300)) &&
        (!('message' in data) || data.message == null || (data.message is string && data.message.size() <= 2000)) &&
        (!('estimatedEndTime' in data) || data.estimatedEndTime == null || (data.estimatedEndTime is string && data.estimatedEndTime.size() <= 100)) &&
        (!('allowOrganizerBypass' in data) || data.allowOrganizerBypass == null || data.allowOrganizerBypass is bool) &&
        (!('contactEmail' in data) || data.contactEmail == null || (data.contactEmail is string && data.contactEmail.size() <= 200)) &&
        (!('supportLink' in data) || data.supportLink == null || (data.supportLink is string && data.supportLink.size() <= 500)) &&
        (!('showSocialLinks' in data) || data.showSocialLinks == null || data.showSocialLinks is bool) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 100)) &&
        (!('updatedBy' in data) || data.updatedBy == null || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
        (!('updatedByName' in data) || data.updatedByName == null || (data.updatedByName is string && data.updatedByName.size() <= 200));
    }

    // ===============================================================
    // Collection Security Rules
    // ===============================================================

    // Root default deny for any unmatched document paths
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Members Collection
    // -------------------------------------------------------------
    match /members/{memberId} {
      // Individual profile lookup: Self-read by auth UID, non-existent doc lookup, Bevy ID doc match with uid/id, or profiles containing referral_code evaluated BEFORE hasMemberTeamAccess to prevent circular role evaluations.
      allow get: if (isAuthenticated() && (
          isMemberDocOwner(memberId, resource) ||
          resource == null ||
          ('referral_code' in resource.data)
        )) || hasMemberTeamAccess(memberId, resource);

      // Listing members: Team access (Organizers & Staff), or authenticated users running strictly bounded queries (limit <= 5) such as referral code lookup.
      allow list: if hasTeamAccess() ||
        (isAuthenticated() && request.query.limit != null && request.query.limit <= 5);

      // Creation: Authenticated profile owners initializing their own account (evaluated first to avoid circular team lookup), or team access creating for another member.
      // Solves bootstrap deadlock while strictly requiring valid member schema and identity ownership.
      allow create: if isValidMember(request.resource.data) && (
        (
          (request.auth.uid == memberId || (('uid' in request.resource.data) && request.resource.data.uid == request.auth.uid) || (('id' in request.resource.data) && request.resource.data.id == request.auth.uid)) &&
          (!('id' in request.resource.data) || request.resource.data.id == request.auth.uid || request.resource.data.id == memberId) &&
          (!('uid' in request.resource.data) || request.resource.data.uid == null || request.resource.data.uid == request.auth.uid) &&
          (!('referral_points' in request.resource.data) || request.resource.data.referral_points == 0) &&
          (!('referrals_count' in request.resource.data) || request.resource.data.referrals_count == 0)
        ) ||
        hasTeamAccess()
      );

      // Update: Team access (inspects resource.data directly without circular get() when updating own record, allows organizers to update members),
      // profile owners (validates identity via isMemberDocOwner, prevents referral tampering & privilege escalation),
      // or authenticated attendees awarding referral points upon redemption.
      allow update: if isValidMember(request.resource.data) && (
        hasMemberTeamAccess(memberId, resource) ||
        (
          isMemberDocOwner(memberId, resource) &&
          isValidMemberOwnerUpdate(resource.data, request.resource.data, request.auth.uid, memberId)
        ) ||
        (
          isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referral_points', 'referrals_count', 'updated_at']) &&
          (!('referral_points' in request.resource.data) || ((request.resource.data.referral_points is int || request.resource.data.referral_points is float) && request.resource.data.referral_points >= 0)) &&
          (!('referrals_count' in request.resource.data) || ((request.resource.data.referrals_count is int || request.resource.data.referrals_count is float) && request.resource.data.referrals_count >= 0))
        )
      );

      // Deletion: Organizers only (avoids circular get when deleting self).
      allow delete: if isMemberOrganizer(memberId, resource);
    }

    // -------------------------------------------------------------
    // Event Registrations Collection
    // -------------------------------------------------------------
    match /event_registrations/{registrationId} {
      // Ensures member (registrant) updates to refund_request are strictly constrained to submission
      function isValidMemberRefundUpdate(prevData, newData) {
        return !newData.diff(prevData).affectedKeys().hasAny(['refund_request']) ||
          (
            (!('refund_request' in prevData) || prevData.refund_request == null || !('status' in prevData.refund_request) || prevData.refund_request.status != 'refund_completed') &&
            (
              !('refund_request' in newData) ||
              newData.refund_request == null ||
              (
                newData.refund_request is map &&
                ('status' in newData.refund_request) &&
                (newData.refund_request.status == 'waiting_for_approval') &&
                !newData.refund_request.keys().hasAny([
                  'completion_proof_url', 'completion_notes', 'completed_at',
                  'completed_by_id', 'completed_by_name', 'completed_by_email',
                  'rejection_reason', 'rejected_at',
                  'rejected_by_id', 'rejected_by_name', 'rejected_by_email'
                ]) &&
                (
                  !('refund_request' in prevData) ||
                  prevData.refund_request == null ||
                  (
                    prevData.refund_request is map &&
                    (!('id' in prevData.refund_request) || !('id' in newData.refund_request) || newData.refund_request.id == prevData.refund_request.id) &&
                    (!('requested_at' in prevData.refund_request) || !('requested_at' in newData.refund_request) || newData.refund_request.requested_at == prevData.refund_request.requested_at)
                  )
                )
              )
            )
          );
      }

      // Individual registration lookup: Team access (Organizers & Staff), or the registrant themselves (matching member_id, member_email, or doc ID suffix).
      // Handles non-existent doc lookup gracefully when resource == null before registration.
      allow get: if hasTeamAccess() ||
        (isAuthenticated() && (
          resource == null ||
          resource.data.member_id == request.auth.uid ||
          resource.data.member_email == request.auth.token.email ||
          (registrationId.size() >= request.auth.uid.size() && registrationId[registrationId.size() - request.auth.uid.size():] == request.auth.uid)
        ));

      // Listing registrations: Team access (Organizers & Staff), or authenticated users querying their own registrations.
      allow list: if hasTeamAccess() ||
        (isAuthenticated() && (
          resource.data.member_id == request.auth.uid ||
          resource.data.member_email == request.auth.token.email
        ));

      // Create: Organizers or authenticated users registering themselves.
      allow create: if isAuthenticated() && isValidRegistration(request.resource.data) &&
        ('registered_at_millis' in request.resource.data) &&
        ((request.resource.data.registered_at_millis is int || request.resource.data.registered_at_millis is float) &&
          request.resource.data.registered_at_millis <= request.time.toMillis() + 300000 &&
          request.resource.data.registered_at_millis >= request.time.toMillis() - 600000) && (
        isOrganizer() ||
        request.auth.uid == request.resource.data.member_id ||
        (registrationId.size() >= request.auth.uid.size() && registrationId[registrationId.size() - request.auth.uid.size():] == request.auth.uid)
      );

      // Update: Team access (Organizers & Staff for attendee curation, status review, check-in, delivery fulfillment) or the registrant updating payment fields, answers, delivery request, refund request, status logs, and RSVP details.
      // Registrants cannot alter review fields or check-in status/timestamps. Identifier value preservation is verified.
      // For merchandise delivery requests, registrants can submit delivery address & fee payment (pending_payment / pending_review), while organizers/staff handle review, approval, rejection, and fulfillment.
      // For refund requests, registrants can submit claims in 'waiting_for_approval' status without setting organizer review/completion fields; completed refunds cannot be tampered with.
      allow update: if isAuthenticated() && isValidRegistration(request.resource.data) && (
        hasTeamAccess() ||
        (
          (
            resource.data.member_id == request.auth.uid ||
            request.resource.data.member_id == request.auth.uid ||
            (registrationId.size() >= request.auth.uid.size() && registrationId[registrationId.size() - request.auth.uid.size():] == request.auth.uid)
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'reviewed_at', 'reviewed_by_id', 'reviewed_by_name', 'reviewed_by_email',
            'checked_in_at', 'is_checked_in', 'bevy_attendee_id', 'attendee_code',
            'registered_at', 'registered_at_millis'
          ]) &&
          isValidMemberDeliveryUpdate(resource.data, request.resource.data) &&
          isValidMemberRefundUpdate(resource.data, request.resource.data)
        )
      );

      // Deletion: Organizers or authenticated registrants cancelling their own registration.
      allow delete: if isOrganizer() || (
        isAuthenticated() && resource != null && (
          resource.data.member_id == request.auth.uid ||
          (registrationId.size() >= request.auth.uid.size() && registrationId[registrationId.size() - request.auth.uid.size():] == request.auth.uid)
        )
      );
    }

    // -------------------------------------------------------------
    // Events Collection
    // -------------------------------------------------------------
    match /events/{eventId} {
      // Read: Public read for events (both guests and community members view GDG events).
      // Safely allows collection queries (orderBy, limit) and single doc lookups when resource == null.
      allow read: if true;

      // Create & Delete: Organizers only.
      allow create: if isOrganizer();
      allow delete: if isOrganizer();

      // Update: Organizers (full event editing), team members updating wrap-up media, sessions & counters, or authenticated users updating event registration/session/voucher counters upon RSVP or cancellation.
      // Non-organizers are strictly constrained to only update total_registrations, total_approved, total_waitlisted, total_checked_in, vouchers, updated_at, sessions, tickets, and bundles, or wrap-up media/sessions and operational counters for team members.
      allow update: if isOrganizer() || (
        isAuthenticated() &&
        isValidEvent(request.resource.data) &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'total_registrations', 'total_approved', 'total_waitlisted', 'total_checked_in',
              'vouchers', 'updated_at', 'sessions', 'tickets', 'bundles'
            ]) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['total_registrations']) || ((request.resource.data.total_registrations is int || request.resource.data.total_registrations is float) && request.resource.data.total_registrations >= 0)) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['total_approved']) || request.resource.data.total_approved == null || ((request.resource.data.total_approved is int || request.resource.data.total_approved is float) && request.resource.data.total_approved >= 0)) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['total_waitlisted']) || request.resource.data.total_waitlisted == null || ((request.resource.data.total_waitlisted is int || request.resource.data.total_waitlisted is float) && request.resource.data.total_waitlisted >= 0)) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['total_checked_in']) || request.resource.data.total_checked_in == null || ((request.resource.data.total_checked_in is int || request.resource.data.total_checked_in is float) && request.resource.data.total_checked_in >= 0))
          ) ||
          (
            hasTeamAccess() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'highlight_video_url', 'highlight_video_title', 'photo_album_url',
              'photo_album_title', 'recap_description', 'sessions', 'updated_at',
              'total_approved', 'total_checked_in', 'total_waitlisted'
            ])
          )
        )
      );
    }

    // -------------------------------------------------------------
    // Event Vouchers Collection (Private promo & sponsor discount vouchers)
    // -------------------------------------------------------------
    match /event_vouchers/{voucherDocId} {
      // Individual voucher validation: Public read for single voucher verification by exact document ID.
      // Allows checkout attendees and guests to look up and validate a promo code without revealing other vouchers.
      allow get: if true;

      // Listing vouchers: Strictly restricted to team members (Organizers & Staff).
      // CRITICAL: Public and regular users MUST NOT be allowed to list or query all vouchers to prevent scraping secret promo codes.
      allow list: if hasTeamAccess();

      // Create & Delete: Team members only (Organizers & Staff), validating schema on create.
      allow create: if hasTeamAccess() && isValidEventVoucher(request.resource.data);
      allow delete: if hasTeamAccess();

      // Update: Team members (full voucher editing) or authenticated users redeeming a voucher upon registration checkout.
      // Regular users are strictly restricted to updating redemption tracking fields and non-negative times_used counter.
      allow update: if isValidEventVoucher(request.resource.data) && (
        hasTeamAccess() ||
        (
          isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'times_used', 'redeemed_by_member_id', 'redeemed_by_name',
            'redeemed_by_email', 'redeemed_at', 'updated_at'
          ]) &&
          (!('times_used' in request.resource.data) || ((request.resource.data.times_used is int || request.resource.data.times_used is float) && request.resource.data.times_used >= 0))
        )
      );
    }

    // -------------------------------------------------------------
    // Sync Metadata Collection
    // -------------------------------------------------------------
    match /sync_metadata/{docId} {
      allow read: if isOrganizer();
      allow write: if isOrganizer() && isValidSyncMetadata(request.resource.data) && docId == 'bevy';
    }

    // -------------------------------------------------------------
    // Content Settings Collection (FAQ, Partnership, Featured Event)
    // -------------------------------------------------------------
    match /content_settings/{docId} {
      // Read: Public read for public website FAQ, partnership, and featured event content.
      allow read: if true;

      // Write: Team access (Organizers & Staff / Core Team), validating schema and limits.
      allow write: if (hasTeamAccess() || isOrganizer()) && isValidContentSettings(request.resource.data, docId);
    }

    // -------------------------------------------------------------
    // Audit Logs Collection
    // -------------------------------------------------------------
    match /audit_logs/{auditId} {
      // Read: Team access (Organizers & Staff).
      allow read: if hasTeamAccess();

      // Create: Team access (Organizers & Staff), validating schema, required fields, and bounds.
      allow create: if hasTeamAccess() && isValidAuditLog(request.resource.data);
    }

    // -------------------------------------------------------------
    // Referral Redemptions Collection
    // -------------------------------------------------------------
    match /referral_redemptions/{redemptionId} {
      // Read: Team access (Organizers & Staff), or authenticated participants (referrer or referee).
      // Gracefully allows non-existent doc lookup (resource == null) and scoped collection queries.
      allow get: if hasTeamAccess() || isOrganizer() ||
        (isAuthenticated() && (
          resource == null ||
          resource.data.referee_id == request.auth.uid ||
          resource.data.referrer_id == request.auth.uid
        ));

      allow list: if hasTeamAccess() || isOrganizer() ||
        (isAuthenticated() && (
          resource.data.referee_id == request.auth.uid ||
          resource.data.referrer_id == request.auth.uid
        ));

      // Create: Team access (Organizers & Staff), or authenticated users creating their own redemption (as referee).
      allow create: if isValidReferralRedemption(request.resource.data) && (
        hasTeamAccess() || isOrganizer() ||
        (isAuthenticated() && (
          request.auth.uid == request.resource.data.referee_id ||
          (('referee_member_id' in request.resource.data) && request.auth.uid == request.resource.data.referee_member_id)
        ))
      );

      // Update: Team access (Organizers & Staff), or authenticated referee updating their own redemption record.
      allow update: if isValidReferralRedemption(request.resource.data) && (
        hasTeamAccess() || isOrganizer() ||
        (isAuthenticated() && (
          (('referee_id' in resource.data) && resource.data.referee_id == request.auth.uid) ||
          (('referee_member_id' in resource.data) && resource.data.referee_member_id == request.auth.uid)
        ))
      );
      allow delete: if hasTeamAccess() || isOrganizer();
    }

    // -------------------------------------------------------------
    // System Settings Collection
    // -------------------------------------------------------------
    match /system_settings/{settingId} {
      // Read: Allowed for authenticated users and public visitors (for attendee checkout code validation & program perks).
      allow read: if true;

      // Write: Team access (Organizers & Staff), validating settings structure and limits per settingId.
      allow create, update: if (hasTeamAccess() || isOrganizer()) && (
        (settingId == 'maintenance' && isValidMaintenanceSetting(request.resource.data)) ||
        (settingId != 'maintenance' && isValidSystemSetting(request.resource.data))
      );
      allow delete: if hasTeamAccess() || isOrganizer();
    }
  }
}

