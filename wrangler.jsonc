{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "gdgjakarta-organizer-dashboard",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
    // Permit harmless dynamic code evaluation during module initialization/startup
    "allow_eval_during_startup"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "BEVY_API_BASE_URL": "https://gdg.community.dev/api",
    "BEVY_CHAPTER_ID": "642",
    "BEVY_CHAPTER_SLUG": "gdg-jakarta",
    "NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyCVk8ECyA8Lqd7KNqdnItxYUu9jdFzoohU",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "1:883556294048:web:364631a561bd411a0ed8c5",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "gdgjakarta-app.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID": "G-YK2P07NQHZ",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "883556294048",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "gdgjakarta-app",
    "N8N_WEBHOOK_BASE_URL": "https://n8n.gdgjakarta.com/webhook/api",
    "N8N_DOKU_NOTIFICATION_WEBHOOK_URL": "https://n8n.gdgjakarta.com/webhook/payment/doku/notifications",
    "DOKU_DEV_CLIENT_ID": "BRN-0233-1766479840736",
    "DOKU_DEV_BASE_URL": "https://api-sandbox.doku.com",
    "DOKU_PROD_CLIENT_ID": "BRN-0272-1766492122366",
    "DOKU_PROD_BASE_URL": "https://api.doku.com",
    "DOKU_CLIENT_ID": "BRN-0272-1766492122366",
    "DOKU_BASE_URL": "https://api.doku.com",
    // SHORTIO_API_KEY must be configured as a secret via `wrangler secret put SHORTIO_API_KEY`
    "SHORTIO_DOMAIN": "gdgjakarta.org",
    "SHORTIO_DOMAIN_ID": "1516440",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY": "AIzaSyAHrt1-lGCA0x-SgRCUY0nP5-jcjujhlmM",
    "NEXT_PUBLIC_R2_PUBLIC_URL": "https://assets.gdgjakarta.org",
    "ORGANIZER_EMAILS": "info@gdgjakarta.org",
    "OPS_AGENT_URL": "https://ops.gdgjakarta.com"
    // OPS_AGENT_SECRET must be configured as a secret via `wrangler secret put OPS_AGENT_SECRET`
    // Secrets to configure via `wrangler secret put <KEY>`:
    // - GOOGLE_SHEETS_API_KEY
    // - N8N_WEBHOOK_API_KEY
    // - PAYMENT_WEBHOOK_SECRET
    // - DOKU_DEV_SECRET_KEY
    // - DOKU_PROD_SECRET_KEY
    // - DOKU_SECRET_KEY
    // - SHORTIO_API_KEY
    // - R2_ACCOUNT_ID
    // - R2_ACCESS_KEY_ID
    // - R2_SECRET_ACCESS_KEY
    // - OPS_AGENT_SECRET
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // The service should match the "name" of your worker
      "service": "gdgjakarta-organizer-dashboard"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    },
    "issues": {
      "enabled": true
    }
  },
  "r2_buckets": [
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "community-dashboard"
    },
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "gdgjakarta-assets",
      "remote": true
    }
  ],
  "images": {
    // Enable image optimization
    // see https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES"
  },
  "previews": {
    "vars": {
      "BEVY_API_BASE_URL": "https://gdg.community.dev/api",
      "BEVY_CHAPTER_ID": "642",
      "BEVY_CHAPTER_SLUG": "gdg-jakarta",
      "NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyCVk8ECyA8Lqd7KNqdnItxYUu9jdFzoohU",
      "NEXT_PUBLIC_FIREBASE_APP_ID": "1:883556294048:web:364631a561bd411a0ed8c5",
      "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "gdgjakarta-app.firebaseapp.com",
      "NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID": "G-YK2P07NQHZ",
      "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "883556294048",
      "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "gdgjakarta-app",
      "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "gdgjakarta-app.firebasestorage.app",
      "N8N_WEBHOOK_BASE_URL": "https://n8n.gdgjakarta.com/webhook/api",
      "N8N_DOKU_NOTIFICATION_WEBHOOK_URL": "https://n8n.gdgjakarta.com/webhook/payment/doku/notifications",
      "DOKU_DEV_CLIENT_ID": "BRN-0233-1766479840736",
      "DOKU_DEV_BASE_URL": "https://api-sandbox.doku.com",
      "DOKU_PROD_CLIENT_ID": "BRN-0272-1766492122366",
      "DOKU_PROD_BASE_URL": "https://api.doku.com",
      "DOKU_CLIENT_ID": "BRN-0272-1766492122366",
      "DOKU_BASE_URL": "https://api.doku.com",
      // SHORTIO_API_KEY must be configured as a secret via `wrangler secret put SHORTIO_API_KEY`
      "SHORTIO_DOMAIN": "gdgjakarta.org",
      "SHORTIO_DOMAIN_ID": "1516440",
      "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY": "AIzaSyAHrt1-lGCA0x-SgRCUY0nP5-jcjujhlmM",
      "NEXT_PUBLIC_R2_PUBLIC_URL": "https://assets.gdgjakarta.org",
      "ORGANIZER_EMAILS": "info@gdgjakarta.org",
      "OPS_AGENT_URL": "https://ops.gdgjakarta.com"
      // OPS_AGENT_SECRET must be configured as a secret via `wrangler secret put OPS_AGENT_SECRET --env preview`
    },
    "r2_buckets": [
      {
        "binding": "NEXT_INC_CACHE_R2_BUCKET",
        "bucket_name": "community-dashboard"
      },
      {
        "binding": "MEDIA_BUCKET",
        "bucket_name": "gdgjakarta-assets",
        "remote": true
      }
    ],
    "images": {
      "binding": "IMAGES"
    }
  }
}
